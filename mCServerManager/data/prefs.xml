<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MCSMAppPrefs" parent="GtkDialog">
    <property name="title" translatable="yes">Preferences</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="content_area">
        <child>
          <object class="GtkGrid" id="grid">
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <property name="row-spacing">12</property>
            <property name="column-spacing">12</property>
            <child>
                <object class="GtkLabel">
                    <layout>
                        <property name="column">0</property>
                        <property name="row">0</property>
                    </layout>
                    <property name="label">_Server Directory:</property>
                    <property name="use-underline">1</property>
                    <property name="mnemonic-widget">server_directory_Entry</property>
                    <property name="xalign">1</property>
                </object>
            </child>
            <child>
                <object class="GtkEntry" id="server_directory_Entry">
                    <layout>
                        <property name="column">1</property>
                        <property name="row">0</property>
                    </layout>
                    <property name="hexpand">1</property>
                </object>
            </child>
            <child>
                <object class="GtkButton" id="server_directory_Button">
                    <layout>
                        <property name="column">2</property>
                        <property name="row">0</property>
                    </layout>
                    <property name="label">Browse...</property>
                </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
